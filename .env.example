# Wapito WhatsApp API. Create a NEW token; do not reuse a token exposed in chat.
WAPITO_API_TOKEN=replace_with_new_wapito_token
WAPITO_API_URL=https://api.wapito.com/v1/messages/text

# Upstash Redis REST credentials (required for OTP/session storage and rate limits)
UPSTASH_REDIS_REST_URL=https://YOUR_DATABASE.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace_with_upstash_rest_token

# Long random secret (at least 32 characters); keep private and stable between deploys.
AUTH_SECRET=replace_with_at_least_32_random_characters
